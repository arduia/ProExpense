CREATE TABLE app_meta (
    id INTEGER NOT NULL PRIMARY KEY,
    monthly_budget_cents INTEGER,
    home_currency_code TEXT NOT NULL,
    failed_attempt_count INTEGER NOT NULL,
    lockout_until INTEGER,
    security_answer_hash TEXT,
    security_question_id TEXT,
    biometric_enrolled INTEGER NOT NULL,
    biometric_wrapped_key BLOB,
    display_name TEXT NOT NULL DEFAULT '',
    onboarding_completed INTEGER NOT NULL DEFAULT 0,
    pin_hash TEXT,
    language_tag TEXT NOT NULL DEFAULT 'en',
    default_category_id TEXT,
    theme_mode TEXT NOT NULL DEFAULT 'system',
    stay_unlocked_in_background INTEGER NOT NULL DEFAULT 0,
    -- Google Drive sync connection state (opt-in, off by default — see docs/user_stories/sync/).
    -- OAuth tokens themselves are never stored here; see EncryptedSyncTokenStore (feature:sync
    -- androidMain).
    sync_connected INTEGER NOT NULL DEFAULT 0,
    sync_account_email TEXT,
    sync_last_synced_at INTEGER
);

insertMeta:
INSERT OR REPLACE INTO app_meta(
    id, monthly_budget_cents, home_currency_code, failed_attempt_count, lockout_until,
    security_answer_hash, security_question_id, biometric_enrolled, biometric_wrapped_key, display_name, onboarding_completed, pin_hash, language_tag, default_category_id, theme_mode, stay_unlocked_in_background, sync_connected, sync_account_email, sync_last_synced_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMeta:
SELECT * FROM app_meta WHERE id = 1;
