-- Normalize finance_record: type TEXT→INTEGER, home_amount_cents nullable when currency==home
-- (no explicit home currency known at schema time, so nullable is the marker for "same as amount_cents")

ALTER TABLE finance_record RENAME TO finance_record_old;

CREATE TABLE finance_record (
    id TEXT NOT NULL PRIMARY KEY,
    amount_cents INTEGER NOT NULL,
    currency_code TEXT NOT NULL,
    home_amount_cents INTEGER,
    category_id TEXT NOT NULL,
    type INTEGER NOT NULL,
    note TEXT,
    recorded_at INTEGER NOT NULL,
    tag_type TEXT,
    tag_id TEXT,
    integrity_algo TEXT,
    integrity_hash TEXT
);

-- Backfill: type TEXT → INTEGER (EXPENSE=0, INCOME=1)
INSERT INTO finance_record
  SELECT id, amount_cents, currency_code, home_amount_cents, category_id,
         CASE type WHEN 'EXPENSE' THEN 0 WHEN 'INCOME' THEN 1 ELSE 0 END,
         note, recorded_at, tag_type, tag_id, integrity_algo, integrity_hash
  FROM finance_record_old;

DROP TABLE finance_record_old;
