CREATE TABLE shared_cost (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    total_cents INTEGER NOT NULL,
    currency_code TEXT NOT NULL,
    recorded_at INTEGER NOT NULL,
    participants_json TEXT NOT NULL,
    custom_shares_json TEXT,
    is_archived INTEGER NOT NULL DEFAULT 0
);

insertSharedCost:
INSERT OR REPLACE INTO shared_cost(id, title, total_cents, currency_code, recorded_at, participants_json, custom_shares_json, is_archived)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllSharedCosts:
SELECT * FROM shared_cost WHERE is_archived = 0 ORDER BY recorded_at DESC;

selectSharedCostById:
SELECT * FROM shared_cost WHERE id = ?;

deleteAllSharedCosts:
DELETE FROM shared_cost;

deleteSharedCost:
DELETE FROM shared_cost WHERE id = ?;

archiveSharedCost:
UPDATE shared_cost SET is_archived = 1 WHERE id = ?;
