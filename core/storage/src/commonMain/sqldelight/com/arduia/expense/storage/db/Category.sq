CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    is_custom INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0
);

insertCategory:
INSERT OR REPLACE INTO category(id, name, is_custom, sort_order) VALUES (?, ?, ?, ?);

seedCategory:
INSERT OR IGNORE INTO category(id, name, is_custom, sort_order) VALUES (?, ?, ?, ?);

deleteCategory:
DELETE FROM category WHERE id = ?;

selectAllCategories:
SELECT * FROM category ORDER BY sort_order, name;

updateCategoryOrder:
UPDATE category SET sort_order = ? WHERE id = ?;
