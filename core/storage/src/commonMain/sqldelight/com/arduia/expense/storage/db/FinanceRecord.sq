-- type: RecordType code (EXPENSE=0, INCOME=1) — explicit codes, never Kotlin .ordinal
-- home_amount_cents/home_currency_code: both null when currency_code == home currency at the time
-- of recording (null signals "use amount_cents/currency_code" — same-currency records never carry
-- the redundant pair). Set together for a converted foreign-currency entry (US-LOG multi-currency).
-- updated_at: system "last modified" timestamp, distinct from recorded_at (user-chosen, possibly-backdated)
-- integrity_hash: hex HMAC-SHA256 over canonical fields, keyed by dedicated Android Keystore HMAC key
-- wallet_id: reserved for future multi-wallet support; no wallet table/feature yet, so always null
-- today. Integer (not TEXT/UUID like every other id here) — wallets are a small, locally-numbered
-- set, chosen up front for this future linkage column.
-- dirty/last_synced_at: Google Drive sync bookkeeping (opt-in, see docs/user_stories/sync/). Not
-- exposed on the shared FinanceRecord domain model — read only through SyncStateRepository. dirty
-- defaults to 1 so every pre-existing and newly-inserted row starts "needs syncing"; a local write
-- (insertRecord) always re-stamps dirty=1, a remote pull merge (upsertRecordFromRemote) clears it.
CREATE TABLE finance_record (
    id TEXT NOT NULL PRIMARY KEY,
    amount_cents INTEGER NOT NULL,
    currency_code TEXT NOT NULL,
    home_amount_cents INTEGER,
    category_id TEXT NOT NULL,
    type INTEGER NOT NULL,
    note TEXT,
    recorded_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    tag_type TEXT,
    tag_id TEXT,
    integrity_algo TEXT NOT NULL,
    integrity_hash TEXT NOT NULL,
    home_currency_code TEXT,
    wallet_id INTEGER,
    dirty INTEGER NOT NULL DEFAULT 1,
    last_synced_at INTEGER
);

CREATE INDEX finance_record_recorded_at_idx ON finance_record(recorded_at DESC, id DESC);

insertRecord:
INSERT OR REPLACE INTO finance_record(
    id, amount_cents, currency_code, home_amount_cents, category_id, type, note, recorded_at, updated_at, tag_type, tag_id, integrity_algo, integrity_hash, home_currency_code, wallet_id, dirty, last_synced_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, NULL);

deleteRecord:
DELETE FROM finance_record WHERE id = ?;

-- Sync-only queries below (feature:sync / SqlDelightSyncStateRepository). Month bucket is derived
-- from recorded_at in UTC via SQLite's strftime(..., 'unixepoch') so it's deterministic regardless
-- of device timezone (US-SYNC business rule) without needing a stored year_month column.
selectRecordsByMonth:
SELECT * FROM finance_record WHERE strftime('%Y-%m', recorded_at / 1000, 'unixepoch') = :yearMonth;

selectDirtyMonths:
SELECT DISTINCT strftime('%Y-%m', recorded_at / 1000, 'unixepoch') AS year_month FROM finance_record WHERE dirty = 1;

markRecordsSyncedForMonth:
UPDATE finance_record SET dirty = 0, last_synced_at = :syncedAt WHERE strftime('%Y-%m', recorded_at / 1000, 'unixepoch') = :yearMonth;

upsertRecordFromRemote:
INSERT OR REPLACE INTO finance_record(
    id, amount_cents, currency_code, home_amount_cents, category_id, type, note, recorded_at, updated_at, tag_type, tag_id, integrity_algo, integrity_hash, home_currency_code, wallet_id, dirty, last_synced_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?);

selectAllRecords:
SELECT * FROM finance_record ORDER BY recorded_at DESC;

selectRecordById:
SELECT * FROM finance_record WHERE id = ?;

sumAmountByEventLink:
SELECT COALESCE(SUM(COALESCE(home_amount_cents, amount_cents)), 0) FROM finance_record WHERE tag_type = 'EVENT' AND tag_id = ?;

deleteAllRecords:
DELETE FROM finance_record;

clearTagsByType:
UPDATE finance_record SET tag_type = NULL, tag_id = NULL WHERE tag_type = ?;

-- Keyset ("cursor") pagination: beforeRecordedAt/beforeId NULL selects the first page. Filters are
-- pushed down to SQL (each `:x IS NULL OR ...` clause turns off the corresponding predicate) so
-- Journal never has to load or scan the full table client-side.
-- `kind` ('SPLIT'/'DEBT') takes over from `categoryId` entirely — Split/Debt records are
-- bookkeeped under a sentinel category id, not a real user category. When `kind` is NULL and
-- `categoryId` is set, Split/Debt records are excluded even though they share that sentinel
-- category id, so picking a real category (e.g. "Shopping") never pulls in Splits/Debts too.
selectRecordsPage:
SELECT * FROM finance_record
WHERE (
    (
      :kind IS NULL
      AND (:categoryId IS NULL OR category_id = :categoryId)
      AND (:categoryId IS NULL OR (tag_type IS NOT 'SHARED_COST' AND (tag_type IS NOT 'DEBT' OR tag_id IS NOT id)))
    )
    OR (:kind = 'SPLIT' AND tag_type = 'SHARED_COST')
    OR (:kind = 'DEBT' AND tag_type = 'DEBT' AND tag_id = id)
  )
  AND (:fromMillis IS NULL OR recorded_at >= :fromMillis)
  AND (:toMillis IS NULL OR recorded_at <= :toMillis)
  AND (:query IS NULL OR note LIKE '%' || :query || '%')
  AND (
    :beforeRecordedAt IS NULL
    OR recorded_at < :beforeRecordedAt
    OR (recorded_at = :beforeRecordedAt AND (:beforeId IS NULL OR id < :beforeId))
  )
ORDER BY recorded_at DESC, id DESC
LIMIT :limit;

existsByCategory:
SELECT EXISTS(SELECT 1 FROM finance_record WHERE category_id = :categoryId);

countAndLastUpdate:
SELECT COUNT(*) AS total, COALESCE(MAX(updated_at), 0) AS lastUpdatedAt FROM finance_record;
