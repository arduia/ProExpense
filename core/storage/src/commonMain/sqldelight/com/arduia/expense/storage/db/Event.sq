-- currency_code: closes gap where Event.budget: Money already carries currency but table didn't store it
-- status: event status code (ACTIVE=0, CLOSED=1) — explicit codes, never Kotlin .ordinal
-- created_at: when the Event row itself was created (audit metadata, distinct from business date range)
-- cached_spent_cents/cache_updated_at: denormalized sum of linked finance_record amounts,
-- recomputed transactionally on every write to a record linked via RecordLink.ToEvent.
CREATE TABLE event_record (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    start_epoch_millis INTEGER NOT NULL,
    end_epoch_millis INTEGER NOT NULL,
    budget_cents INTEGER NOT NULL,
    currency_code TEXT NOT NULL,
    status INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    cached_spent_cents INTEGER NOT NULL DEFAULT 0,
    cache_updated_at INTEGER NOT NULL DEFAULT 0,
    closed_at_epoch_millis INTEGER
);

insertEvent:
INSERT OR REPLACE INTO event_record(
    id, name, start_epoch_millis, end_epoch_millis, budget_cents, currency_code, status, created_at, cached_spent_cents, cache_updated_at, closed_at_epoch_millis
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteEvent:
DELETE FROM event_record WHERE id = ?;

selectAllEvents:
SELECT * FROM event_record ORDER BY start_epoch_millis DESC;

selectEventById:
SELECT * FROM event_record WHERE id = ?;

updateEventCache:
UPDATE event_record SET cached_spent_cents = ?, cache_updated_at = ? WHERE id = ?;

deleteAllEvents:
DELETE FROM event_record;
